{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      "$matchId": {
        ".read": "auth != null && (data.child('user1/uid').val() === auth.uid || data.child('user2/uid').val() === auth.uid)",
        "signaling": {
          ".read": "auth != null && (root.child('matches').child($matchId).child('user1/uid').val() === auth.uid || root.child('matches').child($matchId).child('user2/uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('matches').child($matchId).child('user1/uid').val() === auth.uid || root.child('matches').child($matchId).child('user2/uid').val() === auth.uid)"
        },
        "chat": {
          ".read": "auth != null && (root.child('matches').child($matchId).child('user1/uid').val() === auth.uid || root.child('matches').child($matchId).child('user2/uid').val() === auth.uid)",
          "$messageId": { ".write": "auth != null && (root.child('matches').child($matchId).child('user1/uid').val() === auth.uid || root.child('matches').child($matchId).child('user2/uid').val() === auth.uid) && newData.child('from').val() === auth.uid" }
        }
      }
    },
    "reports": {
      "$reportId": { ".write": "auth != null && newData.child('reporter').val() === auth.uid", ".read": false }
    }
  }
}
